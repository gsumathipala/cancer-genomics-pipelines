.PP
.B comprehensive_variant_calling.py
.BI \-o " OUTPUT_DIR"
.BI \-r " REFERENCE"
.RB [ \-i
.IR INPUT_DIR ]
.RB [ \-\-manifest
.IR MANIFEST ]
.RI [ options ]
.PP
.B pipeline_orchestrator.py
.BI \-\-stage3\-args " ARGS"
.RB [ \-\-stage1\-args
.IR ARGS ]
.RB [ \-\-stage2\-args
.IR ARGS ]
.RI [ options ]
.PP
.B pcgr_report.py
.BI \-\-input\-vcf " VCF"
.BI \-\-output\-dir " DIR"
.BI \-\-sample\-id " ID"
.BI \-\-pcgr\-refdata\-dir " DIR"
.RI [ options ]
.PP
.B coverage_report.py
